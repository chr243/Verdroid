<resources>
    <style name="Theme.Verdroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Share sheet: translucent so the compact (Floating/Bubble) sheet shows over the source app; Full app draws opaque. -->
    <style name="Theme.Verdroid.Share" parent="Theme.Verdroid">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!-- Assistant card: translucent window in its own task so only the card shows over the previous app. -->
    <style name="Theme.Verdroid.Assist" parent="Theme.Verdroid.Share">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
